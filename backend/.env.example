PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=super_secret_grouproute_jwt_key_2026_change_in_prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grouproute
REDIS_URL=redis://localhost:6379
GOOGLE_MAPS_API_KEY=
# Fallback to embedded persistence store if PostgreSQL is not running
USE_LOCAL_STORAGE_FALLBACK=true
# Stop detection threshold in milliseconds (demo: 20000ms = 20s, prod: 180000ms = 3m)
STOP_DETECTION_TIME_MS=20000
# Split detection threshold in kilometers
SPLIT_DISTANCE_KM=5.0
# Rejoin detection threshold in kilometers
REJOIN_DISTANCE_KM=2.0
